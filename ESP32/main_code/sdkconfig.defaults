# sdkconfig.defaults — Industrial Monitor ESP32-S3
#
# Applied automatically when you first run `idf.py build`.
# Phase 1: just the essentials. Phase 2+ will add more.

# --- FreeRTOS trace facility (needed for uxTaskGetSystemState, stack high-water) ---
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# --- Watchdog ---
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT=n              # Disable for Phase 1; enable in Phase 9

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_COLORS=y

# --- FreeRTOS tick rate: 100 Hz (ESP-IDF default, same as warmup) ---
CONFIG_FREERTOS_HZ=100

# --- Stack overflow detection (catch bugs early) ---
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# --- Memory allocation ---
CONFIG_HEAP_TRACING_OFF=n          # Phase 9 might enable for leak debugging

# --- Partition table (custom — see partitions.csv) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- WiFi (Phase 7 will enable; keep defaults for now) ---
CONFIG_ESP_WIFI_STA_DISCONNECT_NAN=y
